@model WebFiles.ViewModels.AccountNotesViewModel

<h1>Notes</h1>
<form action="/account/notes" method="get">
    <input type="text" name="query" placeholder="Note name"></input>
    <input type="submit" value="Search"></input>
</form>
@foreach (var note in Model.Notes)
{
    <table border="1">
        <tr>
            <td>Name</td>
            <td>@note.Name</td>
        </tr>
        <tr>
            <td>View</td>
            <td>
                <a class="btn btn-primary" href="/note/get/@note.Id">View</a>
            </td>
        </tr>
        <tr>
            <td>Edit</td>
            <td>
                <a class="btn btn-primary" href="/note/editindex?noteid=@note.Id">Edit</a>
            </td>
        </tr>
        <tr>
            <td>Is public</td>
            <td>@note.IsPublic</td>
        </tr>
        <tr>
            <td>Change IsPublic</td>
            <td>
                <form action="/note/changepublic/@note.Id" onsubmit="return confirm('Are you sure?');" method="post">
                    <input type="submit" class="btn btn-primary" value="Change"/>
                </form>
            </td>
        </tr>
        <tr>
            <td>Delete</td>
            <td>
                <form action="/note/delete/@note.Id" onsubmit="return confirm('Are you sure?');" method="post">
                    <input type="submit" class="btn btn-danger" value="Delete"/>
                </form>
            </td>
        </tr>
    </table>
}
<span>
    @if (Model.CurrentPage > 0 && Model.PagesTotal > 1)
    {
        <span>|<a href="/account/notes/@(Model.CurrentPage - 1)">Previous</a>|</span>
    }
    @for (int i = 0; i < Model.PagesTotal; i++)
    {
        @if (Model.CurrentPage == i)
        {
            <span>|@(i + 1)|</span>
        }
        else
        {
            <span>|<a href="/account/notes/@i">@(i + 1)</a>|</span>
        }
    }
    @if (Model.CurrentPage + 1 < Model.PagesTotal)
    {
        <span>|<a href="/account/notes/@(Model.CurrentPage + 1)">Next</a>|</span>
    }
</span>