@model WebFiles.ViewModels.NoteEditIndexViewModel

<div class="container-fluid">
    <form action="/note/edit" method="post">
        <div class="row">
            <div class="col-12">
                Name : <input type="text" name="name" value="@Model.Name"></input>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                Title : <input type="text" name="title" value="@Model.Title"></input>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <textarea name="text" id="mdEditor" rows="10">@Model.Text</textarea>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                @if (Model.IsPublic)
                {
                    <span>Is public : <input type="checkbox" name="isPublic" checked="checked"/></span>
                }
                else
                {
                    <span>Is public : <input type="checkbox" name="isPublic"/></span>
                }
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <input type="submit" value="Save"></input>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <button type="button" id="previewUpdateButton">Update preview</button>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div id="mdPreview"></div>
            </div>
        </div>
        <input type="hidden" name="id" value="@Model.NoteId"></input>
    </form>
</div>
<script src="/js/marked.min.js"></script>
<script type="text/javascript" src="/js/mdUpdater.js"></script>