@model WebFiles.Areas.Admin.ViewModels.FilesIndexViewModel

<h1>Files</h1>
<form action="/admin/files" method="get">
    <input type="text" name="query" placeholder="File name"></input>
    <input type="submit" value="Search"></input>
</form>
@foreach (var file in Model.Files)
{
    <hr/>
    <table border="1">
        <tr>
            <td>Name</td>
            <td>@file.Name</td>
        </tr>
        <tr>
            <td>Size</td>
            <td>@((int)(file.Size / 1_048_576)) MB</td>
        </tr>
        <tr>
            <td>UserId</td>
            <td>@file.UserId</td>
        </tr>
        <tr>
            <td>Is public</td>
            <td>@file.IsPublic</td>
        </tr>
        <tr>
            <td>Delete</td>
            <td>
                <form onsubmit="return confirm('Are you sure?');" action="/admin/files/deletefile" method="post">
                    <input type="hidden" name="id" value="@file.Id"><input type="submit" value="Delete" class="btn btn-danger">
                </form>
            </td>
        </tr>
    </table>
    <hr/>
}
<span>
    @if (Model.CurrentPage > 0 && Model.PagesTotal > 1)
    {
        <span>|<a href="/admin/files/@(Model.CurrentPage - 1)">Previous</a>|</span>
    }
    @for (int i = 0; i < Model.PagesTotal; i++)
    {
        @if (Model.CurrentPage == i)
        {
            <span>|@(i + 1)|</span>
        }
        else
        {
            <span>|<a href="/admin/files/@i">@(i + 1)</a>|</span>
        }
    }
    @if (Model.CurrentPage + 1 < Model.PagesTotal)
    {
        <span>|<a href="/admin/files/@(Model.CurrentPage + 1)">Next</a>|</span>
    }
</span>