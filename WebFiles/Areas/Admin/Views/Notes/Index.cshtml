@model WebFiles.Areas.Admin.ViewModels.NotesIndexViewModel

<h1>Notes admin panel</h1>
<form action="/admin/notes" method="get">
    <input type="text" name="query" placeholder="Note name"></input>
    <input type="submit" value="Search"></input>
</form>
@foreach (var note in Model.Notes)
{
    <table border="1">
        <tr>
            <td>Name</td>
            <td>@note.Name</td>
        </tr>
        <tr>
            <td>UserId</td>
            <td>@note.UserId</td>
        </tr>
        <tr>
            <td>Delete</td>
            <td>
                <form action="/admin/notes/delete/@note.Id" onsubmit="return confirm('Are you sure?');" method="post">
                    <input type="submit" class="btn btn-danger" value="Delete"/>
                </form>
            </td>
        </tr>
    </table>
}
<span>
    @if (Model.CurrentPage > 0 && Model.PagesTotal > 1)
    {
        <span>|<a href="/admin/notes/@(Model.CurrentPage-1)">Previous</a>|</span>
    }
    @for (int i = 0; i < Model.PagesTotal; i++)
    {
        @if (Model.CurrentPage == i)
        {
            <span>|@(i+1)|</span>
        }
        else
        {
            <span>|<a href="/admin/notes/@i">@(i+1)</a>|</span>
        }
    }
    @if (Model.CurrentPage + 1 < Model.PagesTotal)
    {
        <span>|<a href="/admin/notes/@(Model.CurrentPage+1)">Next</a>|</span>
    }
</span>