@model WebFiles.Areas.Admin.ViewModels.UsersIndexViewModel
<h1>Users</h1>
<form action="/admin/users" method="get">
    <input type="text" name="query" placeholder="User name"></input>
    <input type="submit" value="Search"></input>
</form>
@foreach (var user in Model.Users)
{
    <table border="1">
        <tr>
            <td>UserName</td>
            <td>@user.UserName</td>
        </tr>
        <tr>
            <td>UserId</td>
            <td>@user.Id</td>
        </tr>
        <tr>
            <td>Delete</td>
            <td>
                <form onsubmit="return confirm('Are you sure?');" action="/admin/users/deleteuser" method="post">
                    <input type="hidden" name="id" value="@user.Id"><input type="submit" value="Delete" class="btn btn-danger">
                </form>
            </td>
        </tr>
        <tr>
            <td>IsExtendedAccount</td>
            <td>@user.IsExtendedAccount</td>
        </tr>
        <tr>
            <td>Change Extended</td>
            <td>
                <form onsubmit="return confirm('Are you sure?');" action="/admin/users/changeextended" method="post">
                    <input type="hidden" name="id" value="@user.Id"><input type="submit" value="Change" class="btn btn-primary">
                </form>
            </td>
        </tr>
    </table>
}
<span>
    @if (Model.CurrentPage > 0 && Model.PagesTotal > 1)
    {
        <span>|<a href="/admin/users/@(Model.CurrentPage-1)">Previous</a>|</span>
    }
    @for (int i = 0; i < Model.PagesTotal; i++)
    {
        @if (Model.CurrentPage == i)
        {
            <span>|@(i+1)|</span>
        }
        else
        {
            <span>|<a href="/admin/users/@i">@(i+1)</a>|</span>
        }
    }
    @if (Model.CurrentPage + 1 < Model.PagesTotal)
    {
        <span>|<a href="/admin/users/@(Model.CurrentPage+1)">Next</a>|</span>
    }
</span>